# Build settings shared by scripts/*.sh. Sourced by bash: plain KEY="value" lines only.
# Commands run inside APP_DIR. (Same layout as the other portfolio repos; here
# the app is the repo root.)

# Directory of the app, relative to the repo root.
APP_DIR="."
# Build output directory, relative to APP_DIR (what GitHub Pages serves).
DIST_DIR="dist"
# Clean, lockfile-exact dependency install (used in CI, where Akari comes from GitHub Packages).
APP_INSTALL="npm ci"
# Static checks (run in CI and by scripts/ci.sh), including the project page standard.
APP_CHECKS="npm run check:projects && npm run check && npm run lint && npm run format:check"
# Production build; writes DIST_DIR.
APP_BUILD="npm run build"
# Browser smoke tests against the build (Playwright + axe).
APP_E2E="npm run test:e2e"
# Dev server; scripts/dev.sh appends --host and any extra args.
APP_DEV="npm run dev --"
# Static preview of the build; scripts/preview.sh appends --port.
APP_PREVIEW="npx astro preview --host 127.0.0.1"
