---
import "~/styles/global.css"

import fontsHref from "~/styles/fonts.css?url"

import Footer from "~/components/Footer.astro"
import SiteHeader from "~/components/SiteHeader.astro"
import { SITE } from "~/lib/site"

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string
  description: string
  /** Open Graph type. */
  type?: "website" | "article"
  noindex?: boolean
  /** Share image (1200×630) under public/, e.g. a project's share card. */
  ogImage?: string
  ogImageAlt?: string
}

const { title, description, type = "website", noindex = false, ogImage: ogPath, ogImageAlt } = Astro.props
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.author} · ${SITE.tagline}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL(ogPath ?? "/og.png", Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Akari pre-paint theme (shared krtmtthw.dev cookie, else localStorage): blocking, external. -->
    <script is:inline src="/theme-init.js" data-shared-cookie-domain="krtmtthw.dev"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Akari webfonts: font-display swap, so the @font-face list need not block first paint. -->
    <link rel="preload" href={fontsHref} as="style" />
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontsHref} />
    </noscript>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? `${SITE.name}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 bg-primary px-3 py-2 text-sm text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
