---
import { Page } from "@abrycta/akari/react"

import ProjectCard from "~/components/ProjectCard.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"
import { getProjects } from "~/lib/projects"

const projects = await getProjects()
---

<BaseLayout
  title="Projects"
  description="Projects by Kurt Matthew Nudo: Typhoon Replay, LGU Lights, Kessan Lens and the Akari design system, with honest status for each."
>
  <Page
    eyebrow="Projects"
    title="Things I am building"
    lede="Data-heavy map and visualisation apps, plus the design system they share. Each page says plainly where the work stands."
  >
    <ul class="grid gap-6 sm:grid-cols-2" role="list">
      {projects.map((project) => (
        <li>
          <ProjectCard project={project} headingLevel={2} />
        </li>
      ))}
    </ul>
  </Page>
</BaseLayout>
