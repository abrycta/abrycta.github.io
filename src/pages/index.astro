---
import ProjectRow from "~/components/ProjectRow.astro"
import StackChips from "~/components/StackChips.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"
import { getProjects } from "~/lib/projects"
import { SITE } from "~/lib/site"

// Every project, in the same order as /projects/. Demo links live on the project pages only.
const projects = await getProjects()

const CONTENTS = [
  { href: "#projects", label: "Projects", value: "Everything I'm building" },
  { href: "#practice", label: "Practice", value: "How I build" },
  { href: "#toolbox", label: "Toolbox", value: "What I build with" },
]

// Each principle is enforced in the projects on this site, not just described.
const PRINCIPLES = [
  {
    title: "One contract, many implementations",
    body: "The API is defined before any server exists. Replay's OpenAPI 3.1 contract is the single source of truth, and one conformance suite is the bar every backend must clear. Java, Go, Node and Rust all clear it. If it doesn't pass, it doesn't ship.",
    seen: [{ href: "/projects/replay/", label: "Replay" }],
  },
  {
    title: "Resilient by design",
    body: "Every dependency is assumed to fail. Each data source sits behind mirrors and a private archive, and each new version is validated, then swapped in whole, so bad data never goes live. When the server sleeps, the edge keeps answering; the replays never depended on it.",
    seen: [
      { href: "/projects/lights/", label: "Lights" },
      { href: "/projects/replay/", label: "Replay" },
    ],
  },
  {
    title: "Performance first",
    body: "The expensive work is done before you arrive. Replay ships 2,058 storms as precomputed frames, decoded off the main thread and drawn on the GPU. Lights runs its model in your browser, compiled from Rust to WebAssembly. Speed is measured on a throttled phone, never on a fast laptop.",
    seen: [
      { href: "/projects/lights/", label: "Lights" },
      { href: "/projects/replay/", label: "Replay" },
    ],
  },
  {
    title: "Integrity",
    body: "No estimate passes as a fact. Every figure in Lights says whether it is official or modelled, carries its uncertainty, and is backtested against real survey rounds. The model is scored against the simplest alternative: carrying the last survey forward. Replay puts the official track beside the reanalysis and shows where they disagree.",
    seen: [
      { href: "/projects/lights/", label: "Lights" },
      { href: "/projects/replay/", label: "Replay" },
    ],
  },
]

// Only technologies used in the projects on this site.
const TOOLBOX = [
  { group: "Programming", items: ["Java", "TypeScript", "Rust", "Python", "SQL"] },
  { group: "Backend", items: ["Spring Boot", "Spring Modulith", "OpenAPI 3.1", "PostgreSQL · PostGIS", "Docker"] },
  {
    group: "Data and ML",
    items: [
      "IBTrACS",
      "ERA5",
      "Parquet",
      "Hugging Face Datasets",
      "Night-light imagery (DMSP-OLS, VIIRS)",
      "MODIS NDVI and EVI",
      "Recurrent neural networks (GRU)",
    ],
  },
  {
    group: "Frontend",
    items: ["React", "Vite", "TanStack Router", "MapLibre GL", "WebGL2", "Astro", "Tailwind CSS v4", "shadcn/ui"],
  },
  {
    group: "Infra and quality",
    items: ["GitHub Actions", "Cloudflare Pages", "GitHub Pages", "Playwright", "axe-core", "Vitest", "Storybook"],
  },
]
---

<BaseLayout description="Kurt Matthew Nudo, software engineer working on enterprise Java systems for Japanese banking clients and data-heavy map apps. Projects and the Akari design system.">
  <div class="mx-auto grid max-w-[1120px] gap-16 px-4 py-10 md:gap-ak-section-gap md:py-14">
    <!-- Hero -->
    <section aria-labelledby="intro-title" class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="grid max-w-[64ch] gap-6">
        <h1 id="intro-title" class="text-ak-display tracking-tight">
          Quiet tools that make data legible.
        </h1>
        <div class="grid gap-3 text-lg text-muted-foreground">
          <p>
            I'm {SITE.author}, a full-stack developer at IBM, migrating Japanese banking systems, and I build data-heavy
            map apps that turn large public datasets into something you can read at a glance.
          </p>
        </div>
      </div>
      <nav aria-label="On this page" class="hidden border-l pl-6 lg:block">
        <ul class="grid gap-4" role="list">
          {CONTENTS.map((c) => (
            <li>
              <a href={c.href} class="group grid gap-0.5">
                <span class="eyebrow">{c.label}</span>
                <span class="text-sm underline-offset-[0.25em] group-hover:underline">{c.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    <!-- Projects -->
    <section id="projects" aria-labelledby="projects-title" class="grid gap-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="grid max-w-[60ch] gap-3">
          <p class="eyebrow">Work</p>
          <h2 id="projects-title" class="text-ak-section tracking-tight">
            Projects
          </h2>
          <p class="text-muted-foreground">
            Public records of storms, night lights and volcanoes, built on one design system. Each page shows what is
            live and what comes next.
          </p>
        </div>
      </div>
      <ul class="grid border-t" role="list" data-testid="project-rows">
        {projects.map((project) => (
          <ProjectRow project={project} />
        ))}
      </ul>
    </section>

    <!-- How I build -->
    <section id="practice" aria-labelledby="practice-title" class="grid gap-6">
      <div class="grid max-w-[60ch] gap-3">
        <p class="eyebrow">Practice</p>
        <h2 id="practice-title" class="text-ak-section tracking-tight">
          How I build
        </h2>
        <p class="text-muted-foreground">Four rules, no exceptions.</p>
      </div>
      <ol class="grid gap-x-10 gap-y-6 md:grid-cols-2" role="list">
        {PRINCIPLES.map((p, i) => (
          <li class="grid content-start gap-3 border-t pt-6">
            <p class="font-mono text-xs text-muted-foreground" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="text-xl">{p.title}</h3>
            <p class="text-muted-foreground">{p.body}</p>
            <p class="text-sm">
              <span class="text-muted-foreground">Seen in </span>
              {p.seen.map((x, j) => (
                <>
                  {j > 0 && <span class="text-muted-foreground"> · </span>}
                  <a class="link" href={x.href}>
                    {x.label}
                  </a>
                </>
              ))}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Toolbox -->
    <section id="toolbox" aria-labelledby="toolbox-title" class="grid gap-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
      <div class="grid content-start gap-3">
        <p class="eyebrow">Toolbox</p>
        <h2 id="toolbox-title" class="text-ak-section tracking-tight">
          What I build with
        </h2>
        <p class="text-muted-foreground">Only what the projects here actually use.</p>
      </div>
      <dl class="grid gap-0">
        {TOOLBOX.map((t) => (
          <div class="grid gap-3 border-t py-5 sm:grid-cols-[140px_minmax(0,1fr)] sm:gap-6">
            <dt class="eyebrow sm:pt-1">{t.group}</dt>
            <dd>
              <StackChips items={t.items} label={t.group} />
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>
