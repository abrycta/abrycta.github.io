---
import { buttonVariants } from "@abrycta/akari/react"

import ProjectRow from "~/components/ProjectRow.astro"
import StackChips from "~/components/StackChips.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"
import { getProjects } from "~/lib/projects"
import { GITHUB, LINKEDIN, SITE } from "~/lib/site"

// Every project, in the same order as /projects/. Demo links live on the project pages only.
const projects = await getProjects()

const CONTENTS = [
  { href: "#projects", label: "Projects", value: "Everything I'm building" },
  { href: "#practice", label: "Practice", value: "How I build" },
  { href: "#toolbox", label: "Toolbox", value: "What I build with" },
]

// Each principle is something the projects on this site already do.
const PRINCIPLES = [
  {
    title: "One contract, many implementations",
    body: "Typhoon Replay's API is written once in OpenAPI 3.1, then implemented in Java, Go, Node and Rust behind the same front end. One conformance suite decides when a backend is done: the Java backend is built and tested against it, and the other three follow.",
    seen: { href: "/projects/typhoon-replay/", label: "Typhoon Replay" },
  },
  {
    title: "Resilient by design",
    body: "Things will fail, so each layer has a fallback. When an upstream dataset moves or breaks, the pipeline falls back to mirrors and then to a private archive, and validation keeps bad data from replacing good data. When a backend is asleep or down, the edge serves cached answers, and the replay itself never needs a server.",
    seen: { href: "/projects/typhoon-replay/", label: "Typhoon Replay" },
  },
  {
    title: "Performance first",
    body: "Heavy work happens ahead of time: storm data is precomputed into static files, decoded in Web Workers and drawn with WebGL, and API reads are cached at the edge, so a repeat request is answered in milliseconds without reaching the server. Speed is measured on a throttled phone, not assumed.",
    seen: { href: "/projects/typhoon-replay/", label: "Typhoon Replay" },
  },
  {
    title: "Honest about the data",
    body: "Reanalysis smooths the cores of intense typhoons, so Typhoon Replay labels its ERA5 field as reanalysis context and always shows the official best-track intensity beside it. LGU Lights is designed the same way: official estimates with their intervals, beside the model.",
    seen: { href: "/projects/typhoon-replay/", label: "Typhoon Replay" },
  },
]

// Only technologies used in the projects on this site.
const TOOLBOX = [
  { group: "Programming", items: ["Java", "TypeScript", "Rust", "Python", "SQL"] },
  { group: "Backend", items: ["Spring Boot", "Spring Modulith", "OpenAPI 3.1", "PostgreSQL · PostGIS", "Docker"] },
  {
    group: "Data and ML",
    items: [
      "IBTrACS",
      "ERA5",
      "Parquet",
      "Hugging Face Datasets",
      "Night-light imagery (DMSP-OLS, VIIRS)",
      "MODIS NDVI and EVI",
      "Recurrent neural networks (GRU)",
    ],
  },
  {
    group: "Frontend",
    items: ["React", "Vite", "TanStack Router", "MapLibre GL", "WebGL2", "Astro", "Tailwind CSS v4", "shadcn/ui"],
  },
  {
    group: "Infra and quality",
    items: ["GitHub Actions", "Cloudflare Pages", "GitHub Pages", "Playwright", "axe-core", "Vitest", "Storybook"],
  },
]

const primaryButton = buttonVariants({ size: "lg" })
const outlineButton = buttonVariants({ variant: "outline", size: "lg" })
---

<BaseLayout description="Kurt Matthew Nudo, software engineer working on enterprise Java systems for Japanese banking clients and data-heavy map apps. Projects and the Akari design system.">
  <div class="mx-auto grid max-w-[1120px] gap-28 px-4 py-16 md:gap-36 md:py-24">
    <!-- Hero -->
    <section aria-labelledby="intro-title" class="grid items-end gap-12 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="grid max-w-[64ch] gap-6">
        <p class="eyebrow">{SITE.tagline}</p>
        <h1 id="intro-title" class="text-[clamp(32px,6vw,56px)] leading-[1.1] tracking-tight">
          Quiet tools that make data legible.
        </h1>
        <div class="grid gap-3 text-lg text-muted-foreground">
          <p>
            I'm {SITE.author}, a software engineer. I work on enterprise Java systems for Japanese banking clients, and
            I build data-heavy map apps that turn large public datasets into something you can read at a glance.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 pt-2">
          <a class={primaryButton} href="#projects">
            See the projects
          </a>
          <a class={outlineButton} href={GITHUB.url}>
            GitHub <span class="font-mono text-xs text-muted-foreground">@{GITHUB.handle}</span>
          </a>
          <a class={outlineButton} href={LINKEDIN.url}>
            LinkedIn
          </a>
        </div>
      </div>
      <nav aria-label="On this page" class="hidden border-l pl-6 lg:block">
        <ul class="grid gap-4" role="list">
          {CONTENTS.map((c) => (
            <li>
              <a href={c.href} class="group grid gap-0.5">
                <span class="eyebrow">{c.label}</span>
                <span class="text-sm underline-offset-[0.25em] group-hover:underline">{c.value}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    <!-- Projects -->
    <section id="projects" aria-labelledby="projects-title" class="grid gap-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="grid max-w-[60ch] gap-3">
          <p class="eyebrow">Work</p>
          <h2 id="projects-title" class="text-[clamp(26px,4vw,36px)] tracking-tight">
            Projects
          </h2>
          <p class="text-muted-foreground">
            One live, two planned, and the design system they all share. Each has an honest status.
          </p>
        </div>
      </div>
      <ul class="grid border-t" role="list" data-testid="project-rows">
        {projects.map((project) => (
          <ProjectRow project={project} />
        ))}
      </ul>
    </section>

    <!-- How I build -->
    <section id="practice" aria-labelledby="practice-title" class="grid gap-10">
      <div class="grid max-w-[60ch] gap-3">
        <p class="eyebrow">Practice</p>
        <h2 id="practice-title" class="text-[clamp(26px,4vw,36px)] tracking-tight">
          How I build
        </h2>
        <p class="text-muted-foreground">Four habits, each visible in the work on this site.</p>
      </div>
      <ol class="grid gap-x-12 gap-y-10 md:grid-cols-2" role="list">
        {PRINCIPLES.map((p, i) => (
          <li class="grid content-start gap-3 border-t pt-6">
            <p class="font-mono text-xs text-muted-foreground" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="text-xl">{p.title}</h3>
            <p class="text-muted-foreground">{p.body}</p>
            <p class="text-sm">
              <span class="text-muted-foreground">Seen in </span>
              <a class="link" href={p.seen.href}>
                {p.seen.label}
              </a>
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Toolbox -->
    <section
      id="toolbox"
      aria-labelledby="toolbox-title"
      class="grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]"
    >
      <div class="grid content-start gap-3">
        <p class="eyebrow">Toolbox</p>
        <h2 id="toolbox-title" class="text-[clamp(26px,4vw,36px)] tracking-tight">
          What I build with
        </h2>
        <p class="text-muted-foreground">Only what the projects here actually use.</p>
      </div>
      <dl class="grid gap-0">
        {TOOLBOX.map((t) => (
          <div class="grid gap-3 border-t py-5 sm:grid-cols-[140px_minmax(0,1fr)] sm:gap-6">
            <dt class="eyebrow sm:pt-1">{t.group}</dt>
            <dd>
              <StackChips items={t.items} label={t.group} />
            </dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>
