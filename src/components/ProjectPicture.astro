---
/**
 * The one picture of a project, shared by its home row and its page:
 * - live apps (Replay, Lights): light and dark screenshots (CSS in global.css shows the one for the active theme),
 *   upgraded on capable devices to the app's frozen live embed (src/scripts/live-embed.ts); the screenshot
 *   stays the first paint, the fallback and the text alternative. No link to the app here: live apps are
 *   linked only from their project page (the demo button);
 * - Kessan Lens (shelved): light and dark renders of its prototype design, captioned as a design;
 * - Akari: a live Akari component;
 * - anything else: a dashed placeholder tile with the project's glyph, until it goes live.
 */
import { buttonVariants } from "@abrycta/akari/react"
import { Image } from "astro:assets"

import AkariTeaser from "~/components/islands/AkariTeaser"
import type { Project } from "~/lib/projects"
import lightsShotDark from "~/assets/lights-home-dark.png"
import lightsShotLight from "~/assets/lights-home-light.png"
import kessanDesignDark from "~/assets/kessan-lens-design-dark.png"
import kessanDesignLight from "~/assets/kessan-lens-design-light.png"
import typhoonShotDark from "~/assets/typhoon-replay-home-dark.png"
import typhoonShotLight from "~/assets/typhoon-replay-home-light.png"

interface Props {
  project: Project
  /** `sizes` for the responsive screenshot. */
  sizes: string
  class?: string
  /** Project pages: the live Akari component takes its own height instead of the home row's 16:10 box. */
  fitContent?: boolean
}
const { project, sizes, class: className, fitContent = false } = Astro.props
const { title, glyph } = project.data

const SHOTS = {
  replay: {
    light: typhoonShotLight,
    dark: typhoonShotDark,
    alt: "Replay's storm page for Haiyan (Yolanda), 2013, at landfall: a map of the Philippines with the storm's dotted track and its ERA5 wind field spiralling around the eye, beside the best-track intensity panel",
    caption: "Haiyan (Yolanda), 2013, at landfall in the Philippines. Captured from the live site.",
    embed: {
      src: "https://replay.krtmtthw.dev/embed/storm/2013306N07162",
      live: "https://replay.krtmtthw.dev/storm/2013306N07162?t=2013-11-07T21:00Z&v=124.31,11.17,4.6",
      width: 1440,
      height: 900,
      title: "Replay, live: Typhoon Haiyan (Yolanda) at landfall, 2013",
    },
  },
  lights: {
    light: lightsShotLight,
    dark: lightsShotDark,
    alt: "Lights' map zoomed to Occidental Mindoro in 2023, with Abra de Ilog selected: towns shaded by poverty rate, striped where figures are less reliable, and a side panel showing 37.8 % (PSA official, 90 % interval 35–41), a plain-language summary and its 2012–2025 trend with model-estimate bands",
    caption:
      "Abra de Ilog, Occidental Mindoro, 2023: PSA official figure with its plain-language summary. Captured from the live site.",
    embed: {
      src: "https://lights.krtmtthw.dev/embed?year=2023&lgu=PH1705101",
      live: "https://lights.krtmtthw.dev/?year=2023&lgu=PH1705101",
      width: 1280,
      height: 800,
      title: "Lights, live: poverty map of Occidental Mindoro in 2023, with Abra de Ilog selected",
    },
  },
  "kessan-lens": {
    light: kessanDesignLight,
    dark: kessanDesignDark,
    alt: "Prototype design of Kessan Lens, not a live app, with illustrative figures for a fictional company: the company page for Hoshino Precision Co., Ltd. (星野精密株式会社), with headline ratios and a five-year income statement in Japanese and English",
    caption: "Prototype design (illustrative figures, fictional company), not a live app.",
    // Not a priority (shelved): shown greyed out.
    muted: true,
  },
} as const
const shot = SHOTS[project.id as keyof typeof SHOTS]
const embed = shot && "embed" in shot ? shot.embed : undefined
const muted = shot && "muted" in shot && shot.muted
const captionId = `picture-caption-${project.id}`

const kind = shot ? "shot" : project.id === "akari" ? "live" : "placeholder"
const CAPTIONS = {
  shot: shot?.caption ?? "",
  live: "A live Akari component: switch the trend.",
  placeholder: "Screenshot when it goes live.",
}
const mark = glyph ?? title
const markIsJa = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u.test(mark)
const shotClass = "aspect-[16/10] h-auto w-full rounded-sm border bg-card object-cover shadow-sm"
---

<figure class:list={["m-0 grid min-w-0 content-start gap-3", className]} data-picture={kind}>
  {shot && embed && (
    <div
      class="live-embed relative min-w-0"
      data-live-embed={project.id}
      data-embed="static"
      data-embed-src={embed.src}
      data-embed-width={embed.width}
      data-embed-height={embed.height}
      data-embed-title={embed.title}
      data-embed-describedby={captionId}
    >
      <Image
        src={shot.light}
        alt={`${shot.alt}, in its light theme.`}
        widths={[640, 960, 1280, 1920]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading="lazy"
        data-theme-shot="light"
        class:list={["theme-shot-light", shotClass]}
      />
      <Image
        src={shot.dark}
        alt={`${shot.alt}, in its dark theme.`}
        widths={[640, 960, 1280, 1920]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading="lazy"
        data-theme-shot="dark"
        class:list={["theme-shot-dark", shotClass]}
      />
    </div>
  )}
  {shot && !embed && (
    <>
      <Image
        src={shot.light}
        alt={`${shot.alt}, in its light theme.`}
        widths={[640, 960, 1280, 1920]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading="lazy"
        data-theme-shot="light"
        class:list={["theme-shot-light", shotClass, muted && "grayscale"]}
      />
      <Image
        src={shot.dark}
        alt={`${shot.alt}, in its dark theme.`}
        widths={[640, 960, 1280, 1920]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading="lazy"
        data-theme-shot="dark"
        class:list={["theme-shot-dark", shotClass, muted && "grayscale"]}
      />
    </>
  )}
  {kind === "live" && (
    <div
      class:list={[
        "grid content-center rounded-sm border bg-card p-4",
        fitContent ? "sm:p-6" : "sm:aspect-[16/10] sm:p-8",
      ]}
      data-testid="akari-preview"
    >
      <div class="w-full">
        <AkariTeaser client:visible />
      </div>
    </div>
  )}
  {kind === "placeholder" && (
    <div class="grid aspect-[16/10] w-full place-items-center rounded-sm border border-dashed border-ak-border-strong bg-muted">
      <span
        aria-hidden="true"
        lang={markIsJa ? "ja" : undefined}
        class="font-heading text-[clamp(48px,9vw,80px)] leading-none font-bold text-muted-foreground"
      >
        {mark}
      </span>
    </div>
  )}
  <figcaption id={captionId} class="text-sm text-muted-foreground">
    {CAPTIONS[kind]}
  </figcaption>
</figure>

<script>
  import "~/scripts/live-embed"
</script>
