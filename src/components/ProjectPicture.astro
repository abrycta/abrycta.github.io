---
/**
 * The one picture of a project, shared by its home row and its page:
 * - live apps (Replay, Lights): only the app's live embed, an iframe of its /embed page, on every device (CLAUDE.md
 *   rule 6b; no screenshot anywhere). The slot is a quiet placeholder (Akari tokens, the project's glyph) in the
 *   picture's exact 16:10 box, so nothing shifts; src/scripts/live-embed.ts starts the iframe as the page loads,
 *   lays it out (desktop or compact), cross-fades it in once the app says it has painted, and pauses it
 *   off-screen. Without JavaScript, a plain iframe in <noscript> fills the slot at its real size (the app's
 *   compact layout). The figcaption says what the embed shows and is the iframe's description. No link to the
 *   app here: live apps are linked only from their project page (the demo button);
 * - Kessan Lens (shelved): light and dark renders of its prototype design, captioned as a design;
 * - Akari: a live Akari component;
 * - anything else: a dashed placeholder tile with the project's glyph, until it goes live.
 */
import { Image } from "astro:assets"

import AkariTeaser from "~/components/islands/AkariTeaser"
import type { Project } from "~/lib/projects"
import kessanDesignDark from "~/assets/kessan-lens-design-dark.png"
import kessanDesignLight from "~/assets/kessan-lens-design-light.png"

interface Props {
  project: Project
  /** `sizes` for the responsive screenshot. */
  sizes: string
  class?: string
  /** Project pages: the live Akari component takes its own height instead of the home row's 16:10 box. */
  fitContent?: boolean
}
const { project, sizes, class: className, fitContent = false } = Astro.props
const { title, glyph } = project.data

/** Live apps: their /embed page (the app's fixed desktop frame size; compact mode uses the slot's own size). */
const EMBEDS = {
  replay: {
    src: "https://replay.krtmtthw.dev/embed/storm/2013306N07162",
    width: 1440,
    height: 900,
    title:
      "Replay: Typhoon Haiyan (Yolanda) nearing landfall in Leyte, 7 November 2013, with its best track and ERA5 winds",
    caption:
      "Live from Replay: Typhoon Haiyan (Yolanda) nearing landfall in Leyte on 7 November 2013 (21:00 UTC), with its best track and the ERA5 wind field around it.",
  },
  lights: {
    src: "https://lights.krtmtthw.dev/embed?year=2023&lgu=PH1705101",
    width: 1280,
    height: 800,
    title: "Lights: a tour of six towns and cities across the Philippines in 2023, with their poverty figures",
    caption:
      "Live from Lights: a tour of six towns and cities across the Philippines in 2023, each with its poverty figure and its source (PSA official or Lights' model estimate).",
  },
} as const
const SHOTS = {
  "kessan-lens": {
    light: kessanDesignLight,
    dark: kessanDesignDark,
    alt: "Prototype design of Kessan Lens, not a live app, with illustrative figures for a fictional company: the company page for Hoshino Precision Co., Ltd. (星野精密株式会社), with headline ratios and a five-year income statement in Japanese and English",
    caption: "Prototype design (illustrative figures, fictional company), not a live app.",
    // Not a priority (shelved): shown greyed out.
    muted: true,
  },
} as const
const embed = EMBEDS[project.id as keyof typeof EMBEDS]
const shot = SHOTS[project.id as keyof typeof SHOTS]
const muted = shot?.muted
const captionId = `picture-caption-${project.id}`

const kind = embed ? "embed" : shot ? "shot" : project.id === "akari" ? "live" : "placeholder"
const CAPTIONS = {
  embed: embed?.caption ?? "",
  shot: shot?.caption ?? "",
  live: "A live Akari component: switch the trend.",
  placeholder: "Screenshot when it goes live.",
}
const mark = glyph ?? title
const markIsJa = /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u.test(mark)
/** The embed's placeholder shows the glyph's first character (CLAUDE.md rule 6). */
const embedMark = [...mark][0]
const shotClass = "aspect-[16/10] h-auto w-full rounded-sm border bg-card object-cover shadow-sm"
---

<figure class:list={["m-0 grid min-w-0 content-start gap-3", className]} data-picture={kind}>
  {embed && (
    <div
      class="live-embed relative aspect-[16/10] w-full min-w-0 overflow-hidden rounded-sm border bg-muted shadow-sm"
      data-live-embed={project.id}
      data-embed="loading"
      data-embed-src={embed.src}
      data-embed-width={embed.width}
      data-embed-height={embed.height}
      data-embed-title={embed.title}
      data-embed-describedby={captionId}
    >
      <span
        aria-hidden="true"
        lang={markIsJa ? "ja" : undefined}
        class="absolute inset-0 grid place-items-center font-heading text-[clamp(40px,7vw,64px)] leading-none font-bold text-muted-foreground"
        data-embed-placeholder
      >
        {embedMark}
      </span>
      {/* No JavaScript: the slot's own size, so the app picks its compact layout; it moves (no parent to pause it). */}
      <noscript>
        <iframe
          src={`${embed.src}${embed.src.includes("?") ? "&" : "?"}lang=en`}
          title={embed.title}
          aria-describedby={captionId}
          sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
          referrerpolicy="strict-origin-when-cross-origin"
          class="absolute inset-0 h-full w-full border-0"
        ></iframe>
      </noscript>
    </div>
  )}
  {shot && (
    <>
      <Image
        src={shot.light}
        alt={`${shot.alt}, in its light theme.`}
        widths={[640, 960, 1280, 1920]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading="lazy"
        data-theme-shot="light"
        class:list={["theme-shot-light", shotClass, muted && "opacity-45 contrast-75 grayscale"]}
      />
      <Image
        src={shot.dark}
        alt={`${shot.alt}, in its dark theme.`}
        widths={[640, 960, 1280, 1920]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading="lazy"
        data-theme-shot="dark"
        class:list={["theme-shot-dark", shotClass, muted && "opacity-45 contrast-75 grayscale"]}
      />
    </>
  )}
  {kind === "live" && (
    <div
      class:list={[
        "grid content-center rounded-sm border bg-card p-4",
        fitContent ? "sm:p-6" : "sm:aspect-[16/10] sm:p-8",
      ]}
      data-testid="akari-preview"
    >
      <div class="w-full">
        <AkariTeaser client:visible />
      </div>
    </div>
  )}
  {kind === "placeholder" && (
    <div class="grid aspect-[16/10] w-full place-items-center rounded-sm border border-dashed border-ak-border-strong bg-muted">
      <span
        aria-hidden="true"
        lang={markIsJa ? "ja" : undefined}
        class="font-heading text-[clamp(48px,9vw,80px)] leading-none font-bold text-muted-foreground"
      >
        {mark}
      </span>
    </div>
  )}
  <figcaption id={captionId} class="text-sm text-muted-foreground">
    {CAPTIONS[kind]}
  </figcaption>
</figure>

<script>
  import "~/scripts/live-embed"
</script>
