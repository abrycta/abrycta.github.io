---
import { Badge } from "@abrycta/akari/react"

interface Props {
  items: string[]
  label?: string
}
const { items, label = "Stack" } = Astro.props
---

<ul class="flex flex-wrap gap-1.5" aria-label={label}>
  {items.map((item) => (
    <li>
      <Badge variant="outline" className="font-mono font-normal">
        {item}
      </Badge>
    </li>
  ))}
</ul>
