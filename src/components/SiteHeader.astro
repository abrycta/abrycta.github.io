---
import HeaderBar from "~/components/HeaderBar"
import ProfileLinks from "~/components/ProfileLinks.astro"
import SiteControls from "~/components/islands/SiteControls"
import { NAV } from "~/lib/site"

const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`
const isCurrent = (href: string) => path.startsWith(href)
---

<HeaderBar>
  {NAV.map((item) => (
    <a
      href={item.href}
      aria-current={isCurrent(item.href) ? "page" : undefined}
      class="py-2 underline-offset-[0.35em] hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:underline aria-[current=page]:decoration-seal aria-[current=page]:decoration-2"
    >
      {item.label}
    </a>
  ))}
  <div slot="actions" class="flex items-center gap-2">
    <ProfileLinks />
    <span aria-hidden="true" class="h-5 w-px bg-border"></span>
    <SiteControls client:idle />
  </div>
</HeaderBar>
