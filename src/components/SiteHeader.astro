---
import HeaderBar from "~/components/HeaderBar"
import ProfileLinks from "~/components/ProfileLinks.astro"
import SiteControls from "~/components/islands/SiteControls"
import { NAV } from "~/lib/site"

const current = Astro.url.pathname
---

<HeaderBar>
  {NAV.map((item) => (
    <a
      href={item.href}
      aria-current={item.href === current ? "page" : undefined}
      class="py-2 underline-offset-[0.35em] hover:text-foreground hover:underline aria-[current=page]:text-foreground aria-[current=page]:underline"
    >
      {item.label}
    </a>
  ))}
  <div slot="actions" class="flex items-center gap-2">
    <ProfileLinks />
    <span aria-hidden="true" class="h-5 w-px bg-border"></span>
    <SiteControls client:idle />
  </div>
</HeaderBar>

<style is:global>
  /*
   * Phones: the brand and the controls share the first row, and the nav (left-aligned, after the name on
   * wider screens) takes its own row below. Akari's <Header> groups brand + nav in one non-wrapping div;
   * `display: contents` lets the three pieces wrap as siblings of the controls.
   */
  @media (width < 40rem) {
    [data-slot="app-header"] > div > div:first-child {
      display: contents;
    }
    [data-slot="app-header"] > div > div:first-child > nav {
      order: 3;
      flex-basis: 100%;
      gap: var(--ak-space-3);
    }
  }
</style>
